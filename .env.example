# ==========================================
# Alumni Connect Portal - Environment Configuration
# ==========================================

# Application Environment (development, testing, production)
FLASK_ENV=development
FLASK_DEBUG=1
SECRET_KEY=change-this-to-a-secure-random-secret-key-in-production
JWT_SECRET_KEY=change-this-to-a-secure-jwt-key-in-production
JWT_ACCESS_TOKEN_EXPIRES_MINUTES=1440

# Database Configuration (MySQL 8.0)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_mysql_password
DB_NAME=alumni_portal

# CORS Allowed Origins (comma-separated)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# File Upload Settings
UPLOAD_FOLDER=uploads
MAX_CONTENT_LENGTH=10485760

# Optional External AI/LLM Adapter Configuration
LLM_PROVIDER=offline_fallback
LLM_API_KEY=
